# Import the Unsloth GGUF quant of Gemma 3n E4B-it into Ollama.
#
# 1. Download a quant into this folder (Q4_K_M is a good CPU balance). Match the
#    exact filename to what the repo lists, then update the FROM line below:
#       huggingface-cli download unsloth/gemma-3n-E4B-it-GGUF \
#           gemma-3n-E4B-it-Q4_K_M.gguf --local-dir models
#
# 2. Create the Ollama model (run from the repo root):
#       ollama create gemma3n-e4b -f models/Modelfile.gemma3n-e4b
#
# 3. Set configs/default.yaml -> llm.model to "gemma3n-e4b".
#
# NOTE: the simpler default is to let Ollama pull the GGUF directly from HF
# (`ollama pull hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M`) — this Modelfile is the
# fallback for when you want a local .gguf or need to force the chat template.
#
# NOTE: Gemma 3n is a recent architecture — you need a current Ollama build
# (`ollama --version`; upgrade if `create` complains about an unknown arch).
# This is still a ~4B-class model, so on CPU expect tens of seconds per call:
# use `run_eval.py --quick` or a small --n-boundary.

FROM ./gemma-3n-E4B-it-Q4_K_M.gguf

PARAMETER temperature 0.0
PARAMETER num_predict 256
PARAMETER stop "<end_of_turn>"

# Gemma chat template: Gemma has no separate system role, so system/user turns
# are folded into a single user turn. Without this, chat output is malformed.
TEMPLATE """{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if or (eq .Role "user") (eq .Role "system") }}<start_of_turn>user
{{ .Content }}<end_of_turn>
{{ if $last }}<start_of_turn>model
{{ end }}
{{- else if eq .Role "assistant" }}<start_of_turn>model
{{ .Content }}{{ if not $last }}<end_of_turn>
{{ end }}
{{- end }}
{{- end }}"""
